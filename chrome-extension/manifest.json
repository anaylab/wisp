{
  "manifest_version": 3,
  "name": "Wisp Tabs",
  "version": "2.0.0",
  "description": "Lets Wisp, your on-device Mac companion, work with your tabs and the pages you ask about. Talks only to Wisp on this Mac (127.0.0.1).",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "tabs",
    "tabGroups",
    "alarms",
    "storage",
    "contextMenus",
    "webNavigation"
  ],
  "optional_permissions": [
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "incognito": "not_allowed",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Wisp Tabs",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "omnibox": {
    "keyword": "w"
  },
  "commands": {
    "ask-wisp-about-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Ask Wisp about this page"
    }
  }
}
