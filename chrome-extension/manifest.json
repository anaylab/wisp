{
  "manifest_version": 3,
  "name": "Wisp Tabs",
  "version": "1.0.0",
  "description": "Lets Wisp, your on-device Mac companion, organize your Chrome tabs. Talks only to Wisp on this Mac (127.0.0.1).",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["tabs", "tabGroups", "alarms", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Wisp Tabs",
    "default_popup": "popup.html"
  }
}
